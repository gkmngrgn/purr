# Copy this file to .env and fill in real values:
#   cp .env.sample .env        (Windows: Copy-Item .env.sample .env)
#
# .env is gitignored and must never be committed. .env.sample is the
# committed template and must contain placeholders only.

# Hugging Face token with the "Make calls to Inference Providers" permission.
# Also used for TURN credential lookup on Spaces.
HF_TOKEN=hf_your_token_here

# ai-coustics SDK license key from https://developers.ai-coustics.com
AIC_SDK_LICENSE=your_license_key_here
