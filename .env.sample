# Copy this file to .env and fill in real values:
#   cp .env.sample .env        (Windows: Copy-Item .env.sample .env)
#
# .env is gitignored and must never be committed. .env.sample is the
# committed template and must contain placeholders only.

# Hugging Face token with the "Make calls to Inference Providers" permission.
HF_TOKEN=hf_your_token_here

# ai-coustics SDK license key from https://developers.ai-coustics.com
AIC_SDK_LICENSE=your_license_key_here

# Cloudflare Calls TURN relay credentials. Optional, but WebRTC on Hugging Face
# Spaces needs a relay because direct/STUN connections are blocked by the Space
# firewall (the old free turn.fastrtc.org endpoint is dead). Create a TURN app:
# https://dash.cloudflare.com/?to=/:account/calls -> TURN Server.
CLOUDFLARE_TURN_KEY_ID=your_turn_key_id_here
CLOUDFLARE_TURN_KEY_API_TOKEN=your_turn_key_api_token_here
